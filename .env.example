# Touchline Environment Variables Template
# Copy this file to .env locally: cp .env.example .env

# PostgreSQL Database Connection String
# Replace user, password, host, port, and dbname with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/touchline?schema=public"

# NextAuth / Auth.js Secret (Generate using `openssl rand -base64 32`)
NEXTAUTH_SECRET="your-development-nextauth-secret-do-not-use-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
