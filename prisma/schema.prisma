datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
}

enum MatchEventKind {
  KICK_OFF
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISS
  SHOT_ON_TARGET
  SHOT_OFF_TARGET
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  INJURY
  HALF_TIME
  FULL_TIME
}

enum CompetitionType {
  LEAGUE
  CUP
  SUPER_CUP
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managers  Manager[]
}

model Manager {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  nationality String
  reputation  Int      @default(50)
  userId      String?
  clubId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
}

model Club {
  id             String   @id @default(cuid())
  name           String   @unique
  shortName      String
  code           String   @unique
  stadiumName    String
  reputation     Int      @default(50)
  primaryColor   String   @default("#000000")
  secondaryColor String   @default("#FFFFFF")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager        Manager?
  players        Player[]
  homeFixtures   Fixture[] @relation("HomeFixtures")
  awayFixtures   Fixture[] @relation("AwayFixtures")
  contracts      Contract[]

  @@index([code])
}

model Player {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  shortName         String
  age               Int
  nationality       String
  primaryPosition   String
  secondaryPositions String[] @default([])
  clubId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  club              Club?             @relation(fields: [clubId], references: [id], onDelete: SetNull)
  attributes        PlayerAttributes?
  contract          Contract?
  matchEventsPrimary MatchEvent[]     @relation("PrimaryPlayer")
  matchEventsSecondary MatchEvent[]   @relation("SecondaryPlayer")

  @@index([clubId])
  @@index([primaryPosition])
}

model PlayerAttributes {
  id             String   @id @default(cuid())
  playerId       String   @unique
  pace           Int      @default(50)
  stamina        Int      @default(50)
  strength       Int      @default(50)
  agility        Int      @default(50)
  passing        Int      @default(50)
  shooting       Int      @default(50)
  tackling       Int      @default(50)
  dribbling      Int      @default(50)
  firstTouch     Int      @default(50)
  heading        Int      @default(50)
  positioning    Int      @default(50)
  vision         Int      @default(50)
  composure      Int      @default(50)
  workRate       Int      @default(50)
  decisionMaking Int      @default(50)
  updatedAt      DateTime @updatedAt

  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Contract {
  id         String   @id @default(cuid())
  playerId   String   @unique
  clubId     String
  wage       Float
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model Competition {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  type      CompetitionType @default(LEAGUE)
  country   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  seasons   Season[]
}

model Season {
  id            String   @id @default(cuid())
  competitionId String
  yearStart     Int
  yearEnd       Int
  isCurrent     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  fixtures      Fixture[]

  @@unique([competitionId, yearStart])
}

model Fixture {
  id            String      @id @default(cuid())
  seasonId      String
  homeClubId    String
  awayClubId    String
  matchDate     DateTime
  matchWeek     Int
  status        MatchStatus @default(SCHEDULED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  season        Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeClub      Club        @relation("HomeFixtures", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClub      Club        @relation("AwayFixtures", fields: [awayClubId], references: [id], onDelete: Cascade)
  match         Match?

  @@index([seasonId])
  @@index([matchDate])
}

model Match {
  id         String      @id @default(cuid())
  fixtureId  String      @unique
  homeScore  Int         @default(0)
  awayScore  Int         @default(0)
  seed       String
  statsJson  String?     // Stored serialized JSON statistics
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  fixture    Fixture     @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  events     MatchEvent[]
}

model MatchEvent {
  id                String         @id @default(cuid())
  matchId           String
  minute            Int
  addedTime         Int?
  kind              MatchEventKind
  teamId            String
  primaryPlayerId   String?
  secondaryPlayerId String?
  description       String
  createdAt         DateTime       @default(now())

  match             Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  primaryPlayer     Player?        @relation("PrimaryPlayer", fields: [primaryPlayerId], references: [id], onDelete: SetNull)
  secondaryPlayer   Player?        @relation("SecondaryPlayer", fields: [secondaryPlayerId], references: [id], onDelete: SetNull)

  @@index([matchId])
}
