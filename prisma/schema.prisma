// ─────────────────────────────────────────────────────────────────────────────
// TOUCHLINE — PRISMA SCHEMA
// Phase 2 Final: Football World & Data Model with Career/Save Isolation
// ─────────────────────────────────────────────────────────────────────────────
//
// ARCHITECTURE NOTES:
//
// 1. CAREER ROOT:
//      User → Career → GameSeason
//    Multiple independent careers can coexist without world-state leakage.
//    Two careers can both have a 2026/27 season without conflict.
//
// 2. SEASON ARCHITECTURE (two levels):
//      GameSeason   — career-scoped football year (e.g. 2026/27)
//      CompetitionSeason — one edition of one competition within that year
//    The retired "Season" model does not exist in this schema.
//
// 3. PLAYER CLUB OWNERSHIP:
//    Player.clubId has been REMOVED.
//    Current club = PlayerClubRegistration WHERE isActive = true
//
// 4. PLAYER AGE:
//    Player.age has been REMOVED.
//    Age is always computed: differenceInYears(dateOfBirth, referenceDate)
//
// 5. PLAYER STATE SPLIT:
//    PlayerCondition (condition) and PlayerCompetitionStats (statistics) are
//    SEPARATE models. Condition is GameSeason-scoped; stats are per-registration
//    per-competition, enabling correct mid-season transfer history.
//
// 6. PLAYER ATTRIBUTES:
//    Stored FLAT in the database (36 columns across 4 groups).
//    The TypeScript domain type presents them in nested groups.
//    Groups: technical (12), physical (8), mental (11), goalkeeping (5)
//
// 7. CURRENT ABILITY:
//    PlayerPotential does NOT contain currentAbility — it is computed at
//    runtime from attributes + position weighting. Never persisted.
//
// 8. MATCH STATISTICS:
//    Match.statsJson has been REMOVED and replaced by MatchStatistics (typed).
//
// 9. MATCH IMMUTABILITY:
//    Completed Match records preserve kick-off snapshots (tactics, lineup,
//    seed, engine version) for exact replay and historical interpretation.
//
// 10. COMPETITION STANDINGS:
//    SeasonClubParticipation counters (played/won/drawn/lost/goals/points)
//    are derived from Match results. They are NOT sourced from PlayerMatchPerformance.
//    A full rebuild from Match records is always possible.
//
// 11. CONTRACTS ARE HISTORICAL RECORDS:
//    Contract.playerId is NOT @unique. A player has many historical contracts.
//    Current contract = WHERE playerId = X AND status = 'ACTIVE' LIMIT 1
//
// 12. FIXTURES LINK TO COMPETITION PHASE:
//    Reach CompetitionSeason via: fixture → phase → competitionSeason.
//
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum PreferredFoot {
  LEFT
  RIGHT
  BOTH
}

enum PlayerPosition {
  GK
  CB
  LB
  RB
  LWB
  RWB
  CDM
  CM
  CAM
  LM
  RM
  LW
  RW
  CF
  ST
}

enum RegistrationType {
  PERMANENT
  LOAN
  FREE_AGENT_SIGNING
  YOUTH_PROMOTION
}

enum InjuryType {
  KNOCK
  MUSCLE_STRAIN
  LIGAMENT
  FRACTURE
  HEAD
  FATIGUE_RELATED
}

enum InjurySeverity {
  MINOR
  MODERATE
  SEVERE
  CAREER_THREATENING
}

enum SuspensionReason {
  YELLOW_CARD_ACCUMULATION
  RED_CARD
  MISCONDUCT
}

enum PersonalityTrait {
  PROFESSIONAL
  DETERMINED
  MODEL_CITIZEN
  TEMPERAMENTAL
  UNAMBITIOUS
  MERCENARY
  LOYAL
  MAVERICK
}

enum AttributeChangeReason {
  TRAINING
  MATCH_PERFORMANCE
  AGE_PROGRESSION
  AGE_DECLINE
  INJURY_RECOVERY
  COACHING_EFFECT
  FACILITY_UPGRADE
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum CompetitionType {
  LEAGUE
  DOMESTIC_CUP
  CONTINENTAL_CUP
  SUPER_CUP
  FRIENDLY
}

enum CompetitionFormat {
  ROUND_ROBIN
  KNOCKOUT
  GROUP_THEN_KNOCKOUT
}

enum CompetitionPhaseType {
  LEAGUE_ROUNDS
  GROUP
  KNOCKOUT_ROUND
  FINAL
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  ABANDONED
}

enum MatchEventKind {
  KICK_OFF
  HALF_TIME
  FULL_TIME
  AET
  PENALTIES
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISS
  YELLOW_CARD
  RED_CARD
  SECOND_YELLOW
  SUBSTITUTION
  INJURY
  VAR_REVIEW
}

enum ClubFacilityLevel {
  POOR
  BELOW_AVERAGE
  AVERAGE
  GOOD
  EXCELLENT
  WORLD_CLASS
}

enum BoardAmbition {
  RELEGATION_BATTLE
  SURVIVAL
  MID_TABLE
  PLAYOFF
  PROMOTION
  TITLE
  EUROPEAN
  CHAMPIONS_LEAGUE
}

// ─────────────────────────────────────────────────────────────────────────────
// GEOGRAPHY
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id        String   @id @default(cuid())
  name      String
  /// ISO 3166-1 alpha-3 code e.g. "ENG", "ESP"
  code      String   @unique
  continent String
  createdAt DateTime @default(now())

  clubs        Club[]
  competitions Competition[]

  @@index([code])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER, CAREER & MANAGER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careers  Career[]
  managers Manager[]
}

/// A Career (game save) is the root of an independent playthrough.
///
/// One user can have many Careers — each is completely isolated:
///   - its own GameSeasons
///   - its own player condition and development history
///   - its own club season states
///   - its own match results
///
/// Two careers can both have a 2026/27 season without conflict.
model Career {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  /// FK → GameSeason — the currently active season for this career.
  /// Nullable: career starts without a season until one is created.
  currentGameSeasonId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Note: currentGameSeason is resolved via separate query to avoid circular FK.
  /// Use: SELECT * FROM GameSeason WHERE id = career.currentGameSeasonId
  gameSeasons  GameSeason[]

  @@index([userId])
}

model Manager {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  nationality String
  /// Global reputation 1–100
  reputation  Int      @default(50)
  /// true = AI-controlled manager
  isAI        Boolean  @default(false)
  userId      String?
  clubId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  club         Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  savedTactics SavedTactic[]
}

// ─────────────────────────────────────────────────────────────────────────────
// CLUB
// ─────────────────────────────────────────────────────────────────────────────

model Club {
  id               String   @id @default(cuid())
  name             String   @unique
  shortName        String
  /// 3-letter code e.g. "ARS", "RMA"
  code             String   @unique
  countryId        String
  city             String
  stadiumName      String
  stadiumCapacity  Int
  /// Global reputation 1–100
  reputation       Int      @default(50)
  /// Domestic prestige within own country 1–100
  domesticPrestige Int      @default(50)
  primaryColor     String   @default("#1a1a1a")
  secondaryColor   String   @default("#ffffff")
  /// Year founded
  founded          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country               Country                  @relation(fields: [countryId], references: [id])
  manager               Manager?
  homeFixtures          Fixture[]                @relation("HomeFixtures")
  awayFixtures          Fixture[]                @relation("AwayFixtures")
  contracts             Contract[]
  seasonStates          ClubSeasonState[]
  registrations         PlayerClubRegistration[]
  participations        SeasonClubParticipation[]
  wonSeasons            CompetitionSeason[]

  @@index([code])
  @@index([countryId])
}

/// Club-level state for a specific GameSeason.
/// One record per club per career year.
/// Scoped to GameSeason (not CompetitionSeason) because budget, morale,
/// and board confidence are holistic across all competitions.
model ClubSeasonState {
  id              String            @id @default(cuid())
  clubId          String
  gameSeasonId    String
  transferBudget  Float             @default(0)
  wageBudget      Float             @default(0)
  /// Board satisfaction with manager 0–100
  boardConfidence Float             @default(50)
  /// Fan happiness index 0–100
  fanHappiness    Float             @default(50)
  /// Squad-wide morale aggregate 0–100
  squadMorale     Float             @default(50)
  facilityLevel   ClubFacilityLevel @default(AVERAGE)
  boardAmbition   BoardAmbition     @default(MID_TABLE)
  updatedAt       DateTime          @updatedAt

  club       Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  gameSeason GameSeason @relation(fields: [gameSeasonId], references: [id], onDelete: Cascade)

  @@unique([clubId, gameSeasonId])
  @@index([gameSeasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GAME SEASON (CAREER YEAR)
// ─────────────────────────────────────────────────────────────────────────────

/// Career-scoped football year container.
/// All in-game events (transfers, matches, development) happen within a GameSeason.
/// A GameSeason (e.g. 2026/27) contains multiple CompetitionSeason records.
///
/// CAREER ISOLATION: Two careers can both have a 2026/27 season.
/// The uniqueness constraint is scoped to (careerId, yearStart, yearEnd).
///
/// isCurrent is career-scoped: at most one GameSeason per Career should
/// have isCurrent = true. Enforce this at the service layer.
model GameSeason {
  id         String   @id @default(cuid())
  /// The career this season belongs to
  careerId   String
  yearStart  Int
  yearEnd    Int
  isCurrent  Boolean  @default(false)
  isComplete Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  career                Career                   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  competitionSeasons    CompetitionSeason[]
  clubSeasonStates      ClubSeasonState[]
  playerConditions      PlayerCondition[]
  playerRegistrations   PlayerClubRegistration[]
  attributeSnapshots    PlayerAttributeSnapshot[]

  /// Uniqueness is career-scoped: each career can have one 2026/27 season.
  @@unique([careerId, yearStart, yearEnd])
  @@index([careerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPETITION
// ─────────────────────────────────────────────────────────────────────────────

/// Persistent competition identity and ruleset.
/// Describes what the competition IS and how it works.
/// Shared across all careers — does not change between seasons.
model Competition {
  id              String            @id @default(cuid())
  name            String
  /// Short code e.g. "EPL", "UCL", "FA_CUP"
  code            String            @unique
  type            CompetitionType   @default(LEAGUE)
  format          CompetitionFormat @default(ROUND_ROBIN)
  /// null for continental competitions
  countryId       String?
  /// "Europe", "South America" etc. for continental competitions
  continent       String?
  /// 1 = top flight, 2 = Championship, etc.
  tier            Int               @default(1)
  teamsCount      Int               @default(20)
  hasPromotion    Boolean           @default(false)
  hasRelegation   Boolean           @default(false)
  promotionSpots  Int               @default(0)
  relegationSpots Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  country Country?          @relation(fields: [countryId], references: [id])
  seasons CompetitionSeason[]
}

/// One edition of a competition within a game season.
/// Example: EPL 2026/27, FA Cup 2026/27, UCL 2026/27 are separate records.
model CompetitionSeason {
  id            String   @id @default(cuid())
  competitionId String
  gameSeasonId  String
  isComplete    Boolean  @default(false)
  /// FK → Club — set when a winner is determined at season end
  winnerClubId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition        Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  gameSeason         GameSeason               @relation(fields: [gameSeasonId], references: [id], onDelete: Cascade)
  winner             Club?                    @relation(fields: [winnerClubId], references: [id], onDelete: SetNull)
  phases             CompetitionPhase[]
  clubParticipations SeasonClubParticipation[]
  playerStats        PlayerCompetitionStats[]
  playerSuspensions  PlayerSuspension[]

  @@unique([competitionId, gameSeasonId])
  @@index([gameSeasonId])
}

/// A structural sub-division of a CompetitionSeason.
/// Fixtures link to CompetitionPhase — reach CompetitionSeason via:
///   fixture → phase → competitionSeason
///
/// The phase model is configurable and does NOT assume any specific
/// real-world competition structure. Examples:
///   EPL 2026/27    → 1 phase:  { type: LEAGUE_ROUNDS, order: 1 }
///   FA Cup 2026/27 → N phases: R3(1), R4(2), R5(3), QF(4), SF(5), Final(6)
///   UCL 2026/27    → 2 phases: { type: GROUP, order: 1 },
///                               { type: KNOCKOUT_ROUND, order: 2 }
model CompetitionPhase {
  id                  String               @id @default(cuid())
  competitionSeasonId String
  name                String
  phaseType           CompetitionPhaseType @default(LEAGUE_ROUNDS)
  /// Sequence number: 1 = first phase of the competition
  order               Int
  startDate           DateTime?
  endDate             DateTime?
  isComplete          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  fixtures          Fixture[]

  @@index([competitionSeasonId])
  @@index([competitionSeasonId, order])
}

/// Club membership in a CompetitionSeason.
///
/// For league and group-stage competitions, accumulates standings counters
/// (played/won/drawn/lost/goals/points) derived from Match results.
///
/// SOURCE OF TRUTH FOR STANDINGS:
///   These counters are populated by the service layer after each Match is
///   simulated, using homeScore/awayScore from the Match record.
///   Standings can always be recomputed from Match results:
///     SELECT all Matches in CompetitionSeason → tally per club.
///   PlayerMatchPerformance is NOT the source for standings.
///
/// For KNOCKOUT competitions:
///   played/won/drawn/lost/points are meaningless. Use CompetitionPhase →
///   Fixture → Match to track knockout round progression instead.
model SeasonClubParticipation {
  id                  String  @id @default(cuid())
  competitionSeasonId String
  clubId              String
  /// Counters derived from Match results. 0 for knockout-only competitions.
  played              Int     @default(0)
  won                 Int     @default(0)
  drawn               Int     @default(0)
  lost                Int     @default(0)
  goalsFor            Int     @default(0)
  goalsAgainst        Int     @default(0)
  points              Int     @default(0)
  /// For group-stage competitions — identifies which group the club is in
  groupId             String?
  /// Set at season end: "PROMOTED" | "RELEGATED" | "PLAYOFF" | null
  promotionStatus     String?

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  club              Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([competitionSeasonId, clubId])
  @@index([competitionSeasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER — IDENTITY
// ─────────────────────────────────────────────────────────────────────────────

/// Core player record. Static identity data that rarely changes.
/// NOTE: age is NOT stored — compute at runtime: differenceInYears(dateOfBirth, now)
/// NOTE: clubId is NOT stored — use PlayerClubRegistration WHERE isActive = true
model Player {
  id                  String           @id @default(cuid())
  firstName           String
  lastName            String
  shortName           String
  dateOfBirth         DateTime
  nationality         String
  secondNationality   String?
  primaryPosition     PlayerPosition
  secondaryPositions  PlayerPosition[]
  preferredFoot       PreferredFoot    @default(RIGHT)
  /// Height in centimetres
  height              Int
  /// Weight in kilograms (optional)
  weight              Int?
  /// false = retired or removed from game world
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  attributes           PlayerAttributes?
  potential            PlayerPotential?
  personality          PlayerPersonality?
  conditions           PlayerCondition[]
  registrations        PlayerClubRegistration[]
  competitionStats     PlayerCompetitionStats[]
  attributeSnapshots   PlayerAttributeSnapshot[]
  injuries             PlayerInjury[]
  suspensions          PlayerSuspension[]
  contracts            Contract[]
  matchPerformances    PlayerMatchPerformance[]
  matchEventsPrimary   MatchEvent[] @relation("PrimaryPlayer")
  matchEventsSecondary MatchEvent[] @relation("SecondaryPlayer")

  @@index([primaryPosition])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER ATTRIBUTES — FLAT STORAGE (36 COLUMNS)
// Stored flat in DB; presented as nested groups in TypeScript domain types.
// All values are integers on the 1–99 scale.
// GK-prefixed columns are null for outfield players.
// Groups: technical (12) + physical (8) + mental (11) + goalkeeping (5) = 36
// ─────────────────────────────────────────────────────────────────────────────

model PlayerAttributes {
  id       String @id @default(cuid())
  playerId String @unique

  // ── TECHNICAL (12) ───────────────────────────────────────────────────────
  passing       Int @default(50)
  longPassing   Int @default(50)
  crossing      Int @default(50)
  finishing     Int @default(50)
  firstTouch    Int @default(50)
  dribbling     Int @default(50)
  ballControl   Int @default(50)
  heading       Int @default(50)
  tackling      Int @default(50)
  marking       Int @default(50)
  freeKick      Int @default(50)
  penaltyTaking Int @default(50)

  // ── PHYSICAL (8) ─────────────────────────────────────────────────────────
  acceleration   Int @default(50)
  pace           Int @default(50)
  stamina        Int @default(50)
  strength       Int @default(50)
  agility        Int @default(50)
  balance        Int @default(50)
  jumping        Int @default(50)
  naturalFitness Int @default(50)

  // ── MENTAL (11) ──────────────────────────────────────────────────────────
  composure      Int @default(50)
  decisions      Int @default(50)
  vision         Int @default(50)
  anticipation   Int @default(50)
  positioning    Int @default(50)
  concentration  Int @default(50)
  workRate       Int @default(50)
  aggression     Int @default(50)
  leadership     Int @default(50)
  teamwork       Int @default(50)
  adaptability   Int @default(50)

  // ── GOALKEEPING (5) — null for outfield players ───────────────────────────
  gkReflexes      Int?
  gkHandling      Int?
  gkPositioning   Int?
  gkKicking       Int?
  gkCommunication Int?

  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER POTENTIAL — HIDDEN FROM UI
// currentAbility is NOT stored here — it is computed from attributes.
// ─────────────────────────────────────────────────────────────────────────────

/// Hidden development profile. Engine and scouting access only.
/// potentialAbility uses a 1–200 internal scale.
/// currentAbility is computed at runtime from attributes — never persisted.
model PlayerPotential {
  id               String   @id @default(cuid())
  playerId         String   @unique
  /// Internal 1–200 scale ceiling
  potentialAbility Int
  /// 0.5 = slow development, 2.0 = rapid
  developmentRate  Float    @default(1.0)
  peakAgeStart     Int      @default(26)
  peakAgeEnd       Int      @default(31)
  updatedAt        DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER PERSONALITY
// ─────────────────────────────────────────────────────────────────────────────

model PlayerPersonality {
  id               String            @id @default(cuid())
  playerId         String            @unique
  /// 1–20. High = seeks bigger club, more likely to request transfers
  ambition         Int               @default(10)
  /// 1–20. High = better development rate multiplier
  professionalism  Int               @default(10)
  /// 1–20. High = accepts below-market wage at favourite club
  loyalty          Int               @default(10)
  /// 1–20. Low = more disciplinary incidents
  temperament      Int               @default(10)
  /// 1–20. Low = composure drops in high-pressure matches
  pressureHandling Int               @default(10)
  /// 1–20. Low = generates negative press events
  mediaHandling    Int               @default(10)
  dominantTrait    PersonalityTrait?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER CONDITION — DYNAMIC STATE PER GAME SEASON
// ─────────────────────────────────────────────────────────────────────────────

/// Player's live condition for a specific GameSeason (career year).
/// One record per player per GameSeason. Updated after each match.
/// Scoped to GameSeason (not CompetitionSeason) because fatigue and morale
/// from a UCL midweek match carry over to the next league weekend match.
model PlayerCondition {
  id                  String   @id @default(cuid())
  playerId            String
  gameSeasonId        String
  /// Available energy for the next match 0–100
  fitness             Float    @default(100)
  /// Accumulated tiredness from recent matches 0–100
  fatigue             Float    @default(0)
  /// Psychological wellbeing 0–100
  morale              Float    @default(75)
  /// Belief in own performance ability 0–100
  confidence          Float    @default(75)
  /// Match practice level — rises with play, falls with absence 0–100
  sharpness           Float    @default(75)
  /// Rolling average of recent match ratings 0–100
  form                Float    @default(50)
  /// Knowledge of the current tactical system 0–100
  tacticalFamiliarity Float    @default(50)
  updatedAt           DateTime @updatedAt

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameSeason GameSeason @relation(fields: [gameSeasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameSeasonId])
  @@index([gameSeasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER CLUB REGISTRATION — COMPLETE CLUB HISTORY
// ─────────────────────────────────────────────────────────────────────────────

/// Records a player's membership at a club.
/// A new registration is created for every transfer, loan, or signing.
///
/// AUTHORITATIVE BOUNDARIES:
///   startDate and endDate are the temporal source of truth.
///   isActive = true identifies the current (active) registration.
///   gameSeasonId is contextual season ownership/indexing, NOT the sole
///   determinant of whether a registration is active.
///
/// QUERIES:
///   Current club = WHERE playerId = X AND isActive = true LIMIT 1
///   Transfer history = WHERE playerId = X ORDER BY startDate DESC
///   Free agents = Player with no active registration
///
/// MULTIPLE ACTIVE REGISTRATION PROTECTION:
///   The @@unique([playerId, isActive]) constraint cannot express partial
///   uniqueness in Prisma (only when isActive = true). This is enforced at
///   the service layer: when creating a new registration, first set the
///   previous registration isActive = false, then create the new one.
///   A database CHECK constraint or trigger can be added in a future migration.
model PlayerClubRegistration {
  id               String           @id @default(cuid())
  playerId         String
  clubId           String
  gameSeasonId     String
  registrationType RegistrationType @default(PERMANENT)
  startDate        DateTime
  endDate          DateTime?
  isActive         Boolean          @default(true)
  /// For loans — the expected return date to the parent club
  loanEndDate      DateTime?
  createdAt        DateTime         @default(now())

  player           Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club             Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  gameSeason       GameSeason             @relation(fields: [gameSeasonId], references: [id], onDelete: Cascade)
  competitionStats PlayerCompetitionStats[]

  @@index([playerId])
  @@index([playerId, isActive])
  @@index([clubId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER COMPETITION STATISTICS
// ─────────────────────────────────────────────────────────────────────────────

/// Statistics for one player registration in one competition season.
/// One record per (PlayerClubRegistration × CompetitionSeason).
///
/// Mid-season transfers produce TWO records for the same competition that year
/// (one per registration). Season totals are SUM queries across both records.
///
/// Source: these counters are updated by the service layer from PlayerMatchPerformance
/// after each match. They are NOT the source of truth for competition standings
/// (that is SeasonClubParticipation, derived from Match results).
model PlayerCompetitionStats {
  id                  String   @id @default(cuid())
  playerId            String
  registrationId      String
  competitionSeasonId String
  appearances         Int      @default(0)
  starts              Int      @default(0)
  minutesPlayed       Int      @default(0)
  goals               Int      @default(0)
  assists             Int      @default(0)
  yellowCards         Int      @default(0)
  redCards            Int      @default(0)
  /// For GKs and defenders
  cleanSheets         Int      @default(0)
  averageRating       Float    @default(0)
  updatedAt           DateTime @updatedAt

  player            Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  registration      PlayerClubRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  competitionSeason CompetitionSeason      @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)

  @@unique([registrationId, competitionSeasonId])
  @@index([playerId])
  @@index([competitionSeasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER ATTRIBUTE SNAPSHOT — DEVELOPMENT AUDIT TRAIL
// ─────────────────────────────────────────────────────────────────────────────

/// Records every attribute change. Forms the complete development history.
/// The development algorithm writes these; it does NOT modify PlayerAttributes directly.
///
/// Example records:
///   { attributeKey: "technical.passing", previousValue: 72, newValue: 74, delta: 2, reason: TRAINING }
///   { attributeKey: "physical.pace",     previousValue: 91, newValue: 89, delta: -2, reason: AGE_DECLINE }
model PlayerAttributeSnapshot {
  id            String                @id @default(cuid())
  playerId      String
  gameSeasonId  String
  /// Dot-notation path e.g. "technical.passing", "physical.pace", "mental.composure"
  attributeKey  String
  previousValue Int
  newValue      Int
  /// newValue - previousValue (positive = improvement, negative = decline)
  delta         Int
  changeReason  AttributeChangeReason
  occurredAt    DateTime              @default(now())

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameSeason GameSeason @relation(fields: [gameSeasonId], references: [id], onDelete: Cascade)

  @@index([playerId, gameSeasonId])
  @@index([playerId, attributeKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER INJURY & SUSPENSION
// ─────────────────────────────────────────────────────────────────────────────

model PlayerInjury {
  id             String         @id @default(cuid())
  playerId       String
  injuryType     InjuryType
  severity       InjurySeverity
  description    String
  startDate      DateTime
  expectedReturn DateTime
  actualReturn   DateTime?
  /// FK → Match if injury occurred during a specific match
  matchId        String?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match  Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([playerId])
}

model PlayerSuspension {
  id                     String           @id @default(cuid())
  playerId               String
  reason                 SuspensionReason
  matchesMissed          Int
  matchesMissedRemaining Int
  /// Suspensions are competition-specific
  competitionSeasonId    String
  startedAtFixtureId     String?

  player            Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  startedAtFixture  Fixture?          @relation(fields: [startedAtFixtureId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([competitionSeasonId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRACT — HISTORICAL LEGAL AGREEMENTS
// ─────────────────────────────────────────────────────────────────────────────

/// A legal agreement between a player and a club.
///
/// Contracts are HISTORICAL RECORDS — NOT a single row per player.
/// A player's career contract history:
///   Arsenal:    2025-07-01 → 2028-06-30  (status: EXPIRED)
///   Real Madrid: 2028-07-01 → 2032-06-30  (status: EXPIRED)
///   Barcelona:  2032-07-01 → 2035-06-30  (status: ACTIVE)
///
/// playerId is NOT @unique — this is intentional and architecturally correct.
///
/// QUERIES:
///   Current contract = WHERE playerId = X AND status = 'ACTIVE' LIMIT 1
///   Contract history = WHERE playerId = X ORDER BY startDate DESC
model Contract {
  id            String         @id @default(cuid())
  playerId      String
  clubId        String
  startDate     DateTime
  weeklyWage    Float
  expiresAt     DateTime
  releaseClause Float?
  signingBonus  Float?
  /// e.g. "Key Player", "Important Player", "Rotation", "Squad Player"
  squadRole     String?
  status        ContractStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, status])
  @@index([clubId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FIXTURE & MATCH
// ─────────────────────────────────────────────────────────────────────────────

/// A scheduled match. Links to CompetitionPhase (not CompetitionSeason directly).
/// Reach CompetitionSeason via: fixture → phase → competitionSeason
model Fixture {
  id                 String      @id @default(cuid())
  competitionPhaseId String
  homeClubId         String
  awayClubId         String
  matchDate          DateTime
  matchWeek          Int
  isNeutralVenue     Boolean     @default(false)
  status             MatchStatus @default(SCHEDULED)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  competitionPhase CompetitionPhase @relation(fields: [competitionPhaseId], references: [id], onDelete: Cascade)
  homeClub         Club             @relation("HomeFixtures", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClub         Club             @relation("AwayFixtures", fields: [awayClubId], references: [id], onDelete: Cascade)
  match            Match?
  suspensions      PlayerSuspension[]

  @@index([competitionPhaseId])
  @@index([matchDate])
}

/// Authoritative, immutable result of a completed match simulation.
/// Lineup and tactics snapshots are stored as versioned JSON blobs
/// because they must reflect what existed at kick-off, not what exists today.
///
/// IMMUTABILITY GUARANTEE:
///   No mutable FK references are stored in Match that could silently change
///   the interpretation of a historical result if a player or tactic is later
///   edited. All kick-off state is captured in the snapshot JSON fields.
model Match {
  id                      String   @id @default(cuid())
  fixtureId               String   @unique
  homeScore               Int      @default(0)
  awayScore               Int      @default(0)
  homeScoreHT             Int      @default(0)
  awayScoreHT             Int      @default(0)
  /// TacticDocument JSON blob (immutable snapshot at kick-off)
  homeTacticsSnapshot     Json
  /// TacticDocument JSON blob (immutable snapshot at kick-off)
  awayTacticsSnapshot     Json
  /// Lineup JSON blob — starting XI + bench at kick-off (immutable)
  homeLineupSnapshot      Json
  /// Lineup JSON blob — starting XI + bench at kick-off (immutable)
  awayLineupSnapshot      Json
  /// Version of the snapshot format — enables future migration detection
  snapshotSchemaVersion   String   @default("1")
  /// RNG seed — enables exact match replay
  seed                    String
  /// e.g. "ts-statistical-v1@1.0.0-foundation"
  simulationEngineVersion String
  simulatedAt             DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  fixture            Fixture                @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  statistics         MatchStatistics?
  events             MatchEvent[]
  playerPerformances PlayerMatchPerformance[]
  injuries           PlayerInjury[]

  @@index([simulatedAt])
}

/// Typed match statistics for a completed match.
/// Replaces the previous raw statsJson approach.
///
/// STANDINGS SOURCE: homeScore/awayScore from the Match record (not here).
/// This model stores detailed in-match statistics for display/analysis only.
model MatchStatistics {
  id                String @id @default(cuid())
  matchId           String @unique
  homePossession    Float
  awayPossession    Float
  homeShots         Int
  awayShots         Int
  homeShotsOnTarget Int
  awayShotsOnTarget Int
  /// Expected goals
  homeXg            Float
  awayXg            Float
  homePasses        Int
  awayPasses        Int
  homePassAccuracy  Float
  awayPassAccuracy  Float
  homeFouls         Int
  awayFouls         Int
  homeYellowCards   Int
  awayYellowCards   Int
  homeRedCards      Int
  awayRedCards      Int
  homeCorners       Int
  awayCorners       Int
  homeTackles       Int
  awayTackles       Int
  homeInterceptions Int
  awayInterceptions Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

/// Persisted match events — the significant subset extracted from the
/// simulation's micro-event stream.
///
/// Internal simulation events (passes, carries, duels, presses, positional
/// movements) are in-memory only — they are NEVER persisted here.
model MatchEvent {
  id                String         @id @default(cuid())
  matchId           String
  minute            Int
  addedTime         Int?
  kind              MatchEventKind
  teamId            String
  primaryPlayerId   String?
  secondaryPlayerId String?
  /// Expected goal value for shot/goal events
  xgValue           Float?
  /// Structured event-specific metadata JSON
  metadata          Json?
  description       String
  createdAt         DateTime       @default(now())

  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  primaryPlayer   Player? @relation("PrimaryPlayer", fields: [primaryPlayerId], references: [id], onDelete: SetNull)
  secondaryPlayer Player? @relation("SecondaryPlayer", fields: [secondaryPlayerId], references: [id], onDelete: SetNull)

  @@index([matchId])
}

/// Per-player performance data for a single match.
///
/// SOURCE OF PLAYER STATISTICS:
///   These records feed into PlayerCompetitionStats accumulators.
///   They are NOT the source for competition standings.
///
/// SOURCE OF COMPETITION STANDINGS:
///   Match.homeScore / Match.awayScore → SeasonClubParticipation counters.
model PlayerMatchPerformance {
  id                   String  @id @default(cuid())
  matchId              String
  playerId             String
  teamId               String
  isStarting           Boolean @default(true)
  minutesPlayed        Int     @default(0)
  /// Match rating 1.0–10.0
  rating               Float   @default(6.0)
  goals                Int     @default(0)
  assists              Int     @default(0)
  shots                Int     @default(0)
  shotsOnTarget        Int     @default(0)
  keyPasses            Int     @default(0)
  passesCompleted      Int     @default(0)
  passAccuracy         Float   @default(0)
  tackles              Int     @default(0)
  interceptions        Int     @default(0)
  aerialDuelsWon       Int     @default(0)
  yellowCards          Int     @default(0)
  redCards             Int     @default(0)
  xg                   Float   @default(0)
  xgAssisted           Float   @default(0)
  wasSubstitutedOff    Boolean @default(false)
  substitutedOffMinute Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SAVED TACTICS
// ─────────────────────────────────────────────────────────────────────────────

/// Manager's saved tactical setups.
/// tacticDocument stores a TacticDocument JSON blob — all values are strongly
/// typed in the TypeScript domain layer via the TacticDocument interface.
/// The _schemaVersion field inside the JSON enables future format migration.
model SavedTactic {
  id             String   @id @default(cuid())
  managerId      String
  clubId         String
  name           String
  /// TacticDocument JSON blob — must conform to TacticDocument TypeScript interface
  tacticDocument Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([managerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5: REAL FOOTBALL DATA FOUNDATION & PROVENANCE
// ─────────────────────────────────────────────────────────────────────────────

enum SourceEntityType {
  COUNTRY
  COMPETITION
  CLUB
  PLAYER
  SEASON
  FIXTURE
  MATCH
  PLAYER_STATS
}

enum ImportStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

/// Registry of authoritative external data sources.
model DataSource {
  id                  String   @id @default(cuid())
  name                String
  /// Short code e.g. "OPENFOOTBALL", "DATAHUB", "WIKIDATA", "STATSBOMB"
  code                String   @unique
  url                 String
  license             String
  permittedUse        String
  attributionRequired Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  importBatches       ImportBatch[]
  sourceMappings      SourceMapping[]
  rawDataRecords      RawDataRecord[]

  @@index([code])
}

/// Ingestion batches for traceability and auditability.
model ImportBatch {
  id               String       @id @default(cuid())
  sourceId         String
  batchNumber      String       @unique
  status           ImportStatus @default(STARTED)
  datasetVersion   String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  recordsProcessed Int          @default(0)
  recordsImported  Int          @default(0)
  recordsUpdated   Int          @default(0)
  recordsFailed    Int          @default(0)
  errorSummary     Json?
  metadata         Json?

  source         DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawDataRecords RawDataRecord[]

  @@index([sourceId])
  @@index([status])
}

/// Lineage mapping linking external source entity IDs to canonical internal Touchline IDs.
model SourceMapping {
  id                 String           @id @default(cuid())
  sourceId           String
  entityType         SourceEntityType
  sourceEntityId     String
  internalEntityId   String
  datasetVersion     String?
  confidence         Float            @default(1.0)
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, entityType, sourceEntityId])
  @@index([entityType, internalEntityId])
  @@index([internalEntityId])
}

/// Immutable store of raw ingested records before normalization.
model RawDataRecord {
  id             String           @id @default(cuid())
  importBatchId  String
  sourceId       String
  entityType     SourceEntityType
  sourceEntityId String
  payloadJson    Json
  ingestedAt     DateTime         @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  source      DataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([sourceId, entityType, sourceEntityId])
}

